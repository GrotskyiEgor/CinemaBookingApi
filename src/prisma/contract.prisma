// use prisma-8

model MovieSession {
  id         Int           @id @default(autoincrement())
  movieTitle String
  startsAt   DateTime
  seats      SessionSeat[] 
}

model Seat {
  id       Int           @id @default(autoincrement())
  row      Int
  column   Int
  sessions SessionSeat[]
}

model SessionSeat {
  sessionId Int
  session   MovieSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  seatId    Int
  seat      Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([sessionId, seatId]) 
}